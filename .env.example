# ==============================================================================
# HADESGATE — CONFIGURAÇÕES ESSENCIAIS DE BOOT & SEGURANÇA
# ==============================================================================
# Todas as políticas de DLP, Tenants, Webhooks, Egress Scanning e Modelos Locais
# são gerenciadas no Console Web (ícone ⚙ no canto superior direito), persistidas
# no SQLite e recarregadas em tempo de execução com zero downtime.
#
# O arquivo .env destina-se EXCLUSIVAMENTE às credenciais e variáveis de boot:
# ==============================================================================

# 1. Porta de escuta HTTP
PORT=8080
HADESGATE_PORT=8080

# 2. Chaves de infraestrutura e segurança
# Chave mestre de administração para acessar o Console Web e APIs (/api/*)
HADESGATE_ADMIN_KEY=hadesgate_sec_admin_key_2026

# Segredo HMAC estável (mínimo recomendado: 32 bytes aleatórios) usado somente
# para fingerprintar chaves BYOK. A chave original do provedor nunca é gravada.
HADESGATE_FINGERPRINT_SECRET=troque_por_32_bytes_aleatorios_ou_mais

# Compatibilidade temporária com /p/{key} e /t/{proxy_key}. Mantenha false.
HADESGATE_ALLOW_LEGACY_URL_KEYS=false

# Chave de proxy HadesGate opcional para clientes que não usam BYOK transparente.
# Deve ser diferente da chave administrativa.
HADESGATE_PROXY_KEY=

# Sem esta configuração, requisições cross-origin são negadas por padrão.
# Liste apenas origens confiáveis; curingas são aceitos somente nos formatos
# controlados chrome-extension://* e http://localhost:*.
HADESGATE_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Inspeciona respostas JSON e streams SSE para mascarar PII/segredos novos
# gerados pelo modelo, inclusive valores fragmentados entre chunks.
HADESGATE_ENABLE_EGRESS_SCAN=true

# 3. Banco de dados SQLite local (telemetria Zero-PII e configurações dinâmicas)
HADESGATE_DB_PATH=./data/hadesgate.db

# ==============================================================================
# CREDENCIAIS UPSTREAM DAS LLMS (OBRIGATÓRIO CONFIGURAR AS QUE USAR)
# ==============================================================================

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Endpoints upstream padrão (opcional caso utilize provedores oficiais)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ==============================================================================
# LIMITES OPERACIONAIS DE MEMÓRIA E BUFFER (OPCIONAL)
# ==============================================================================

HADESGATE_MAX_CONCURRENT_REQUESTS=128
HADESGATE_MAX_RESPONSE_BYTES=20971520
HADESGATE_MAX_SSE_EVENT_BYTES=1048576
VAULT_TTL=10m
TRACE_BUFFER_SIZE=1000

# ==============================================================================
# DETECTORES INTERNACIONAIS & REGULATÓRIOS (OPCIONAL - TODOS ATIVOS POR PADRÃO)
# ==============================================================================
# ANONYMIZER_ENABLE_SSN=true
# ANONYMIZER_ENABLE_EIN=true
# ANONYMIZER_ENABLE_NINO=true
# ANONYMIZER_ENABLE_NHS=true
# ANONYMIZER_ENABLE_DNI=true
# ANONYMIZER_ENABLE_NIR=true
# ANONYMIZER_ENABLE_CODICE_FISCALE=true
# ANONYMIZER_ENABLE_MEDICAL=true
# ANONYMIZER_ENABLE_SUS=true
# ANONYMIZER_ENABLE_VEHICLE=true
# ANONYMIZER_ENABLE_LEGAL=true
# ANONYMIZER_ENABLE_DEVICE=true
# ANONYMIZER_ENABLE_GOVERNMENT_ID=true
# ANONYMIZER_ENABLE_CID=true
# ANONYMIZER_ENABLE_MEDICATION=true


